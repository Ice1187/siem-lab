{
  "index_patterns": ["winlogbeat-apt29-host-*"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "30s",
      "mapping.total_fields.limit": 3000
    },
    "mappings": {
      "dynamic_templates": [
        {
          "message_like": {
            "match": "Message",
            "mapping": { "type": "keyword", "index": false, "doc_values": false }
          }
        },
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 2048 }
          }
        }
      ],
      "properties": {
        "@timestamp":          { "type": "date" },
        "@timestamp_original": { "type": "date" },

        "UtcTime":             { "type": "keyword" },
        "UtcTime_original":    { "type": "keyword" },
        "EventTime":           { "type": "keyword" },
        "EventTime_original":  { "type": "keyword" },
        "EventReceivedTime":   { "type": "keyword" },

        "Message":             { "type": "keyword", "index": false, "doc_values": false },

        "EventID":             { "type": "integer" },
        "RecordNumber":        { "type": "long" },
        "Keywords":            { "type": "long" },
        "Task":                { "type": "integer" },
        "OpcodeValue":         { "type": "integer" },
        "SeverityValue":       { "type": "integer" },
        "Version":             { "type": "integer" },
        "ExecutionProcessID":  { "type": "integer" },
        "ThreadID":            { "type": "integer" },
        "port":                { "type": "integer" },

        "ecs":   { "properties": { "version": { "type": "keyword" } } },
        "agent": { "properties": { "type": { "type": "keyword" } } },

        "event": {
          "properties": {
            "kind":     { "type": "keyword" },
            "id":       { "type": "keyword" },
            "code":     { "type": "keyword" },
            "module":   { "type": "keyword" },
            "dataset":  { "type": "keyword" },
            "provider": { "type": "keyword" },
            "category": { "type": "keyword" },
            "type":     { "type": "keyword" },
            "action":   { "type": "keyword" }
          }
        },

        "host": {
          "properties": {
            "name":     { "type": "keyword" },
            "hostname": { "type": "keyword" },
            "id":       { "type": "keyword" },
            "os":       { "properties": { "family": { "type": "keyword" } } }
          }
        },

        "winlog": {
          "properties": {
            "channel":   { "type": "keyword" },
            "event_id":  { "type": "integer" },
            "record_id": { "type": "long" }
          }
        },

        "process": {
          "properties": {
            "entity_id":         { "type": "keyword" },
            "pid":               { "type": "integer" },
            "name":              { "type": "keyword" },
            "executable":        { "type": "keyword" },
            "command_line":      { "type": "keyword", "ignore_above": 8192 },
            "args":              { "type": "keyword", "ignore_above": 2048 },
            "working_directory": { "type": "keyword" },
            "hash": {
              "properties": {
                "md5":    { "type": "keyword" },
                "sha1":   { "type": "keyword" },
                "sha256": { "type": "keyword" }
              }
            },
            "parent": {
              "properties": {
                "entity_id":    { "type": "keyword" },
                "pid":          { "type": "integer" },
                "name":         { "type": "keyword" },
                "executable":   { "type": "keyword" },
                "command_line": { "type": "keyword", "ignore_above": 8192 }
              }
            }
          }
        },

        "user":        { "properties": { "name": { "type": "keyword" }, "domain": { "type": "keyword" } } },
        "file":        { "properties": { "path": { "type": "keyword" }, "name": { "type": "keyword" }, "extension": { "type": "keyword" } } },
        "dll":         { "properties": { "path": { "type": "keyword" }, "name": { "type": "keyword" } } },
        "registry":    { "properties": { "path": { "type": "keyword", "ignore_above": 4096 }, "value": { "type": "keyword" }, "data": { "properties": { "strings": { "type": "keyword", "ignore_above": 4096 } } } } },
        "dns":         { "properties": { "question": { "properties": { "name": { "type": "keyword" } } } } },
        "source":      { "properties": { "ip": { "type": "ip" }, "port": { "type": "integer" } } },
        "destination": { "properties": { "ip": { "type": "ip" }, "port": { "type": "integer" } } },
        "network":     { "properties": { "transport": { "type": "keyword" }, "protocol": { "type": "keyword" }, "direction": { "type": "keyword" } } }
      }
    }
  },
  "_meta": {
    "description": "APT29 evals day1 host events: raw NXLog/WEC fields plus an ECS overlay",
    "note": "process.entity_id MUST stay keyword; if it becomes text the Kibana event analyzer silently stops resolving process trees"
  }
}
